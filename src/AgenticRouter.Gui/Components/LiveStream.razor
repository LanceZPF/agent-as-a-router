@* Live Stream tab: conversation list on left, summary + turn details on right. *@
@if (SelectedOrDefault is null)
{
    <div class="h-full flex items-center justify-center text-xs text-slate-500">No conversations yet.</div>
    @{ return; }
}

<div class="flex h-full gap-2 min-h-0">
    @* Left column: Conversation list *@
    <div class="flex flex-col min-h-0" style="width:35%">
        @* Search *@
        <div class="relative shrink-0 mb-2">
            <Icon Name="search" Size="13" Class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-500" />
            <input type="text"
                   placeholder="Search conversations, agents..."
                   value="@_search"
                   @oninput="e => _search = (string?)e.Value ?? string.Empty"
                   class="w-full rounded pl-8 pr-3 py-2 text-xs font-mono"
                   style="background:#1e293b;border:1px solid #334155;color:#94a3b8" />
        </div>

        @* Conversation Cards *@
        <div class="flex-1 overflow-y-auto space-y-1.5 pr-1">
            @foreach (var conversation in Filtered)
            {
                var isSelected = SelectedId == conversation.Id;
                <ConversationCard Conversation="conversation" IsSelected="isSelected" OnSelect="SelectConversation" />
            }
        </div>
    </div>

    @* Right column: Details *@
    <div class="flex flex-col min-h-0 overflow-y-auto flex-1 space-y-2 pr-1">
        @* Pinned Summary Card *@
        <ConversationSummary Conversation="Selected" />

        @* Turn List *@
        <div class="space-y-1.5">
            @foreach (var turn in Selected.Turns)
            {
                <TurnCard Turn="turn" />
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Conversation> Conversations { get; set; } = [];

    [Parameter, EditorRequired]
    public string SelectedId { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    private string _search = string.Empty;

    private IEnumerable<Conversation> Filtered =>
        Conversations.Where(c => string.IsNullOrEmpty(_search)
            || c.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || c.Turns.Any(t => t.Agent.Contains(_search, StringComparison.OrdinalIgnoreCase))
            || c.Turns.Any(t => t.Model.Contains(_search, StringComparison.OrdinalIgnoreCase))
            || c.Id.Contains(_search, StringComparison.Ordinal));

    private Conversation? SelectedOrDefault => Conversations.FirstOrDefault(c => c.Id == SelectedId) ?? Conversations.FirstOrDefault();

    private Conversation Selected => SelectedOrDefault!;

    private async Task SelectConversation(string conversationId)
    {
        await OnSelect.InvokeAsync(conversationId);
    }
}
