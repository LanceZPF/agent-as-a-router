@using AgenticRouter.Gui.Utils
@* Turn card showing metrics with expandable details. *@
<div class="rounded shrink-0 mb-2" style="background:#1e293b;border-left:4px solid @ColorUtils.GetColorForAgent(Turn.Agent);border-right:1px solid #334155;border-top:1px solid #334155;border-bottom:1px solid #334155">
    @* Header: Title + Expand/Collapse *@
    <button @onclick="() => _expanded = !_expanded"
            class="w-full flex items-center justify-between px-3 py-2 text-left hover:bg-slate-800/20 transition-colors"
            style="background:transparent">
        <div class="flex items-center gap-2 flex-1 min-w-0">
            <span class="text-xs font-semibold text-slate-300">
                🔹 @Turn.Agent
            </span>
            <span class="text-xs text-slate-500">Turn @Turn.TurnNumber</span>
            <span class="text-xs text-slate-600">@Turn.Timestamp</span>
        </div>
        <span class="text-slate-500 text-xs ml-2 shrink-0">@(_expanded ? "▲" : "▼")</span>
    </button>

    @* Metrics (always visible) *@
    <div class="px-3 py-2 space-y-1.5 text-xs font-mono">
        @* Routing ROI *@
        <div class="flex items-center justify-between">
            <span class="text-slate-500 cursor-help" title="Cost reduction from routing this task to a cheaper model vs. worst-case expensive model">
                🎯 Routing ROI:
            </span>
            <span style="color:#10b981">@(Turn.RoutingRoi > 0 ? $"{Turn.RoutingRoi:F1}% ↓" : "—")</span>
        </div>

        @* Total Cost *@
        <div class="flex items-center justify-between">
            <span class="text-slate-500 cursor-help" title="Sum of prompt token cost + completion token cost for this turn">
                💰 Total Cost:
            </span>
            <span style="color:#38bdf8">$@Money6(Turn.TotalCost)</span>
        </div>

        @* Token Volume *@
        <div class="flex items-center justify-between">
            <span class="text-slate-500 cursor-help" title="Prompt tokens sent to LLM + Completion tokens generated. Hockey stick curve visible across turns.">
                📊 Token Volume:
            </span>
            <span style="color:#a78bfa">@Turn.PromptTokens <span style="color:#94a3b8">P</span> | @Turn.CompletionTokens <span style="color:#94a3b8">C</span></span>
        </div>

        @* Tool Execution Steps *@
        <div class="flex items-center justify-between">
            <span class="text-slate-500 cursor-help" title="Number of tool invocations/API calls within this turn's multi-step workflow">
                🔧 Tool Steps:
            </span>
            <span style="color:#f59e0b">@Turn.ToolExecutionSteps loop@(Turn.ToolExecutionSteps != 1 ? "s" : "")</span>
        </div>

        @* Cache Hit Rate *@
        @if (Turn.CacheHitRate > 0)
        {
            <div class="flex items-center justify-between">
                <span class="text-slate-500 cursor-help" title="Percentage of prompt tokens served from Anthropic's prompt cache (if using Claude)">
                    💾 Cache Hit:
                </span>
                <span style="color:#10b981">@Turn.CacheHitRate.ToString("F0")%</span>
            </div>
        }

        @* TTFT *@
        <div class="flex items-center justify-between">
            <span class="text-slate-500 cursor-help" title="Time elapsed from routing decision to first token received from LLM">
                ⏱️ TTFT:
            </span>
            <span style="color:#fb7185">@Turn.TimeToFirstTokenMs ms</span>
        </div>

        @* Context Buffer *@
        <div class="flex items-center justify-between">
            <span class="text-slate-500 cursor-help" title="Current session context size relative to model's max context window">
                📋 Context:
            </span>
            <span style="color:#94a3b8">@Turn.ContextBufferPercent.ToString("F1")% used</span>
        </div>
    </div>

    @* Expanded Content *@
    @if (_expanded)
    {
        <div class="border-t border-slate-700/50 px-3 py-2 space-y-2">
            @* Routing Decision Inspector *@
            <div class="bg-slate-900/40 rounded p-2 space-y-1">
                <div class="text-xs font-semibold text-slate-400">📋 Routing Decision</div>
                @foreach (var step in Turn.RoutingSteps)
                {
                    @switch (step.Status)
                    {
                        case StepStatus.Warn:
                            <div class="flex items-start gap-2 text-xs font-mono"
                                 style="color:#fcd34d">
                                ⚠️ @step.Message
                            </div>
                            break;
                        case StepStatus.Info:
                            <div class="flex items-start gap-2 text-xs font-mono"
                                 style="color:#7dd3fc">
                                👉 @step.Message
                            </div>
                            break;
                        default:
                            <div class="flex items-start gap-2 text-xs font-mono"
                                 style="color:#6ee7b7">
                                ✅ @step.Message
                            </div>
                            break;
                    }
                }
            </div>

            @* Request/Response (Collapsed by Default) *@
            <div class="bg-slate-900/40 rounded overflow-hidden">
                <button @onclick="() => _showRequestResponse = !_showRequestResponse"
                        class="w-full flex items-center justify-between px-2 py-1.5 hover:bg-slate-800/30 transition-colors text-left"
                        style="border:none;background:transparent">
                    <span class="text-xs font-semibold text-slate-400">🔽 Request/Response</span>
                    <span class="text-slate-600 text-xs">@(_showRequestResponse ? "▲" : "▼")</span>
                </button>

                @if (_showRequestResponse)
                {
                    <div class="px-2 pb-2 space-y-1 border-t border-slate-700/30 pt-1.5">
                        @if (!string.IsNullOrEmpty(Turn.RequestSummary))
                        {
                            <div class="text-xs font-mono bg-slate-950/60 rounded p-2 max-h-32 overflow-y-auto"
                                 style="color:#cbd5e1">
                                <div class="text-slate-400 mb-1">📥 Request:</div>
                                <code>@Turn.RequestSummary</code>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Turn.ResponseSummary))
                        {
                            <div class="text-xs font-mono bg-slate-950/60 rounded p-2 max-h-32 overflow-y-auto"
                                 style="color:#cbd5e1">
                                <div class="text-slate-400 mb-1">📤 Response:</div>
                                <code>@Turn.ResponseSummary</code>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ConversationTurn Turn { get; set; } = null!;

    private bool _expanded;
    private bool _showRequestResponse;

    private static string Money6(decimal value) => value.ToString("F6", System.Globalization.CultureInfo.InvariantCulture);
}
