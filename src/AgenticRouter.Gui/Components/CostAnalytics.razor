@* Cost Analytics tab: cumulative savings line chart, a per-agent ROI horizontal bar chart, and a
   per-conversation token-compounding line chart (the "hockey stick" curve deferred here from the
   Live Stream redesign). *@
<div class="h-full flex flex-col gap-3 min-h-0">
    @* Cumulative Savings chart *@
    <div class="rounded-lg p-4 shrink-0 flex flex-col" style="background:#1e293b;border:1px solid #334155;height:34%">
        <div class="flex items-baseline justify-between mb-3 shrink-0">
            <div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Cumulative Savings</div>
                <div class="font-mono text-lg font-semibold mt-0.5" style="color:#10b981">
                    $@(CostData.Count == 0 ? "0.00" : CostData[^1].Cumulative.ToString("F2", CultureInfo.InvariantCulture))
                </div>
            </div>
            <div class="text-xs text-slate-600 font-mono">Jun 1 — Jul 1</div>
        </div>
        <div class="flex-1 min-h-0">
            <ApexChart TItem="CostDataPoint" Options="_lineOptions" Height="@("100%")">
                <ApexPointSeries TItem="CostDataPoint"
                                 Items="CostData"
                                 Name="Cumulative"
                                 SeriesType="SeriesType.Line"
                                 Color="#10b981"
                                 XValue="e => e.Time"
                                 YValue="e => e.Cumulative" />
            </ApexChart>
        </div>
    </div>

    @* ROI per Agent chart *@
    <div class="rounded-lg p-4 shrink-0 flex flex-col" style="background:#1e293b;border:1px solid #334155;height:28%">
        <div class="mb-3 shrink-0">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-widest">ROI by Agent</div>
            <div class="text-xs text-slate-600 mt-0.5">Cost reduction % per operational agent</div>
        </div>
        <div class="flex-1 min-h-0">
            <ApexChart TItem="AgentRoi" Options="_barOptions" Height="@("100%")">
                <ApexPointSeries TItem="AgentRoi"
                                 Items="AgentRoi"
                                 Name="Reduction"
                                 SeriesType="SeriesType.Bar"
                                 XValue="e => e.Agent"
                                 YValue="e => e.Reduction" />
            </ApexChart>
        </div>
    </div>

    @* Token Compounding by Conversation chart *@
    <div class="rounded-lg p-4 flex-1 min-h-0 flex flex-col" style="background:#1e293b;border:1px solid #334155">
        <div class="flex items-center justify-between mb-3 shrink-0">
            <div>
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Token Compounding by Conversation</div>
                <div class="flex items-center gap-4 mt-1.5">
                    <span class="flex items-center gap-1.5 text-xs font-mono text-slate-500">
                        <span class="w-2 h-2 rounded-sm" style="background:#38bdf8"></span> Cumulative Prompt
                    </span>
                    <span class="flex items-center gap-1.5 text-xs font-mono text-slate-500">
                        <span class="w-2 h-2 rounded-sm" style="background:#10b981"></span> Cumulative Completion
                    </span>
                </div>
            </div>
            <select value="@_selectedConversationId"
                    @onchange="OnConversationChanged"
                    class="rounded px-2 py-1.5 text-xs font-mono"
                    style="background:#0f172a;border:1px solid #334155;color:#e2e8f0">
                @foreach (var conversation in Conversations)
                {
                    <option value="@conversation.Id">@conversation.Title</option>
                }
            </select>
        </div>
        @if (_compoundingSeries.Count == 0)
        {
            <div class="flex-1 flex items-center justify-center text-xs text-slate-500">No conversation selected.</div>
        }
        else
        {
            <div class="flex-1 min-h-0">
                <ApexChart TItem="CompoundingPoint" Options="_compoundingOptions" Height="@("100%")">
                    <ApexPointSeries TItem="CompoundingPoint"
                                     Items="_compoundingSeries"
                                     Name="Cumulative Prompt"
                                     SeriesType="SeriesType.Line"
                                     Color="#38bdf8"
                                     XValue="e => e.TurnNumber"
                                     YValue="e => e.CumulativePromptTokens" />
                    <ApexPointSeries TItem="CompoundingPoint"
                                     Items="_compoundingSeries"
                                     Name="Cumulative Completion"
                                     SeriesType="SeriesType.Line"
                                     Color="#10b981"
                                     XValue="e => e.TurnNumber"
                                     YValue="e => e.CumulativeCompletionTokens" />
                </ApexChart>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<CostDataPoint> CostData { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<AgentRoi> AgentRoi { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<Conversation> Conversations { get; set; } = [];

    private ApexChartOptions<CostDataPoint> _lineOptions = new();
    private ApexChartOptions<AgentRoi> _barOptions = new();
    private ApexChartOptions<CompoundingPoint> _compoundingOptions = new();

    private string _selectedConversationId = string.Empty;
    private IReadOnlyList<CompoundingPoint> _compoundingSeries = [];

    protected override void OnInitialized()
    {
        _lineOptions = new ApexChartOptions<CostDataPoint>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Background = "transparent",
                ForeColor = "#475569",
                FontFamily = "JetBrains Mono, monospace",
                Animations = new Animations { Enabled = false },
            },
            Grid = new Grid
            {
                BorderColor = "#1e3a5f",
                StrokeDashArray = 3,
            },
            Stroke = new Stroke { Curve = Curve.MonotoneCubic, Width = 2 },
            DataLabels = new DataLabels { Enabled = false },
            Tooltip = new Tooltip
            {
                Theme = Mode.Dark,
                Y = new TooltipY { Formatter = "function (value) { return '$' + value.toFixed(2); }" },
            },
            Xaxis = new XAxis
            {
                AxisBorder = new AxisBorder { Show = false },
                AxisTicks = new AxisTicks { Show = false },
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { FontSize = "10px" },
                    Rotate = 0,
                    HideOverlappingLabels = true,
                },
            },
            Yaxis =
            [
                new YAxis
                {
                    Min = 0,
                    Max = 160,
                    TickAmount = 4,
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle { FontSize = "10px" },
                        Formatter = "function (value) { return '$' + value.toFixed(0); }",
                    },
                },
            ],
        };

        _barOptions = new ApexChartOptions<AgentRoi>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Background = "transparent",
                ForeColor = "#475569",
                FontFamily = "Inter, sans-serif",
                Animations = new Animations { Enabled = false },
            },
            // One color per data point (in item order), matching the reduction tiers of the original:
            // >= 85% emerald, >= 70% sky, otherwise amber.
            Colors = AgentRoi
                .Select(e => e.Reduction >= 85 ? "#10b981" : e.Reduction >= 70 ? "#38bdf8" : "#f59e0b")
                .ToList(),
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    Horizontal = true,
                    Distributed = true,
                    BarHeight = "35%",
                    BorderRadius = 3,
                },
            },
            Legend = new Legend { Show = false },
            Grid = new Grid
            {
                BorderColor = "#1e3a5f",
                StrokeDashArray = 3,
            },
            DataLabels = new DataLabels
            {
                Enabled = true,
                TextAnchor = TextAnchor.Start,
                OffsetX = 24,
                Formatter = "function (value) { return value.toFixed(1) + '%'; }",
                Style = new DataLabelsStyle
                {
                    FontSize = "10px",
                    FontFamily = "JetBrains Mono, monospace",
                    Colors = ["#94a3b8"],
                },
                DropShadow = new DropShadow { Enabled = false },
            },
            Tooltip = new Tooltip
            {
                Theme = Mode.Dark,
                Y = new TooltipY { Formatter = "function (value) { return value.toFixed(2) + '%'; }" },
            },
            Xaxis = new XAxis
            {
                Min = 0,
                Max = 100,
                TickAmount = 4,
                AxisBorder = new AxisBorder { Show = false },
                AxisTicks = new AxisTicks { Show = false },
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { FontSize = "9px", FontFamily = "JetBrains Mono, monospace" },
                    Formatter = "function (value) { return value + '%'; }",
                },
            },
            Yaxis =
            [
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle { FontSize = "10px", Colors = "#94a3b8" },
                    },
                },
            ],
        };

        _compoundingOptions = new ApexChartOptions<CompoundingPoint>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Background = "transparent",
                ForeColor = "#475569",
                FontFamily = "JetBrains Mono, monospace",
                Animations = new Animations { Enabled = false },
            },
            Stroke = new Stroke { Curve = Curve.MonotoneCubic, Width = 2 },
            DataLabels = new DataLabels { Enabled = false },
            Legend = new Legend { Show = false },
            Grid = new Grid
            {
                BorderColor = "#1e3a5f",
                StrokeDashArray = 3,
            },
            Tooltip = new Tooltip
            {
                Theme = Mode.Dark,
                Y = new TooltipY { Formatter = "function (value) { return value.toLocaleString(); }" },
            },
            Xaxis = new XAxis
            {
                TickAmount = 6,
                AxisBorder = new AxisBorder { Show = false },
                AxisTicks = new AxisTicks { Show = false },
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { FontSize = "10px" },
                },
            },
            Yaxis =
            [
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle { FontSize = "10px" },
                        Formatter = "function (value) { return value >= 1000 ? (value / 1000).toFixed(1) + 'K' : value; }",
                    },
                },
            ],
        };

        if (Conversations.Count > 0)
        {
            _selectedConversationId = Conversations[0].Id;
        }

        RecomputeCompoundingSeries();
    }

    protected override void OnParametersSet()
    {
        RecomputeCompoundingSeries();
    }

    private void OnConversationChanged(ChangeEventArgs e)
    {
        _selectedConversationId = (string?)e.Value ?? string.Empty;
        RecomputeCompoundingSeries();
    }

    private void RecomputeCompoundingSeries()
    {
        var conversation = Conversations.FirstOrDefault(c => c.Id == _selectedConversationId);
        if (conversation is null)
        {
            _compoundingSeries = [];
            return;
        }

        var turns = conversation.Turns
            .Select(t => new TurnTokenPoint(t.TurnNumber, t.PromptTokens, t.CompletionTokens))
            .ToList();
        _compoundingSeries = TokenCompoundingSeries.Build(turns);
    }
}
