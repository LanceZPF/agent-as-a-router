@* Small inline stroke icons (24x24 grid, drawn from basic primitives) used across the dashboard. *@
<svg xmlns="http://www.w3.org/2000/svg"
     width="@Size"
     height="@Size"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="2"
     stroke-linecap="round"
     stroke-linejoin="round"
     class="@Class"
     style="@Style">
    @switch (Name)
    {
        case "activity":
            <polyline points="2 12 7 12 10 4 14 20 17 12 22 12" />
            break;
        case "bar-chart":
            <line x1="6" y1="20" x2="6" y2="14" />
            <line x1="12" y1="20" x2="12" y2="4" />
            <line x1="18" y1="20" x2="18" y2="10" />
            break;
        case "trending-up":
            <polyline points="3 17 9 11 13 15 21 7" />
            <polyline points="15 7 21 7 21 13" />
            break;
        case "shield-check":
            <path d="M12 22C6.8 19.9 4 16.5 4 11V5l8-3 8 3v6c0 5.5-2.8 8.9-8 11z" />
            <polyline points="9 12 11.5 14.5 15.5 9.5" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" />
            <line x1="16.5" y1="16.5" x2="21" y2="21" />
            break;
        case "alert-triangle":
            <path d="M12 3 2 20h20z" />
            <line x1="12" y1="10" x2="12" y2="14" />
            <line x1="12" y1="17" x2="12" y2="17.01" />
            break;
        case "check-circle":
            <circle cx="12" cy="12" r="9" />
            <polyline points="8 12.5 11 15.5 16 9.5" />
            break;
        case "x":
            <line x1="6" y1="6" x2="18" y2="18" />
            <line x1="18" y1="6" x2="6" y2="18" />
            break;
        case "trash":
            <polyline points="3 6 21 6" />
            <path d="M5 6l1 15h12l1-15" />
            <path d="M9 6V3h6v3" />
            <line x1="10" y1="10" x2="10" y2="17" />
            <line x1="14" y1="10" x2="14" y2="17" />
            break;
        case "rotate-ccw":
            <polyline points="2 4 2 10 8 10" />
            <path d="M3.5 14a9 9 0 1 0 2-9.5L2 8" />
            break;
        case "settings":
            <circle cx="12" cy="12" r="3.5" />
            <line x1="12" y1="2" x2="12" y2="5" />
            <line x1="12" y1="19" x2="12" y2="22" />
            <line x1="2" y1="12" x2="5" y2="12" />
            <line x1="19" y1="12" x2="22" y2="12" />
            <line x1="4.9" y1="4.9" x2="7" y2="7" />
            <line x1="17" y1="17" x2="19.1" y2="19.1" />
            <line x1="19.1" y1="4.9" x2="17" y2="7" />
            <line x1="7" y1="17" x2="4.9" y2="19.1" />
            break;
    }
</svg>

@code {
    /// <summary>Which glyph to render; see the switch above for supported names.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    /// <summary>Square size in pixels.</summary>
    [Parameter]
    public int Size { get; set; } = 13;

    /// <summary>Optional CSS classes forwarded to the svg element.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Optional inline style forwarded to the svg element (e.g. a stroke color via `color`).</summary>
    [Parameter]
    public string? Style { get; set; }
}
