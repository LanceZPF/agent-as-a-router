@* Conversation card for left panel showing summary of a session. *@
<button @key="Conversation.Id"
        @onclick="() => OnSelect.InvokeAsync(Conversation.Id)"
        class="w-full text-left rounded card-hover transition-colors"
        style="background:@(IsSelected ? "#263548" : "#1e293b");
               border:1px solid @(IsSelected ? "#38bdf8" : Conversation.HasFallbackTurns ? "#f59e0b33" : "#334155");
               padding:10px;
               cursor:pointer">
    @* Title + Warning Badge *@
    <div class="flex items-center gap-2 mb-2">
        <span class="text-xs font-semibold text-slate-200 truncate">@Conversation.Title</span>
        @if (Conversation.HasFallbackTurns)
        {
            <span class="shrink-0 rounded px-1.5 py-0.5 text-xs font-semibold"
                  style="background:#f59e0b22;color:#f59e0b;border:1px solid #f59e0b44">⚠️</span>
        }
    </div>

    @* Timestamps *@
    <div class="text-xs font-mono text-slate-500 mb-2">
        📅 @Conversation.FirstTimestamp → @Conversation.LastTimestamp
    </div>

    @* Cost & Tokens *@
    <div class="text-xs font-mono mb-2 flex justify-between">
        <span class="text-slate-400">💰 $<span class="text-slate-200">@Money6(Conversation.TotalCost)</span></span>
        <span class="text-slate-400">📦 <span class="text-slate-200">@TokenCount(Conversation.TotalPromptTokens + Conversation.TotalCompletionTokens)</span></span>
    </div>

    @* Turn count & Agent pool *@
    <div class="text-xs font-mono text-slate-500">
        🔄 @Conversation.Turns.Count turn@(Conversation.Turns.Count != 1 ? "s" : "")
        @if (Conversation.Turns.Count > 0)
        {
            var uniqueAgents = Conversation.Turns.Select(t => t.Agent).Distinct().Take(2).ToList();
            <span class="text-slate-600"> | 📊 @string.Join(", ", uniqueAgents)@(Conversation.Turns.Select(t => t.Agent).Distinct().Count() > 2 ? "..." : "")</span>
        }
    </div>
</button>

@code {
    [Parameter, EditorRequired]
    public Conversation Conversation { get; set; } = null!;

    [Parameter]
    public bool IsSelected { get; set; }

    [Parameter]
    public EventCallback<string> OnSelect { get; set; }

    private static string Money6(decimal value) => value.ToString("F6", System.Globalization.CultureInfo.InvariantCulture);

    private static string TokenCount(int tokens)
    {
        if (tokens >= 1_000_000)
            return $"{tokens / 1_000_000.0:F1}M";
        if (tokens >= 1_000)
            return $"{tokens / 1_000.0:F1}K";
        return tokens.ToString();
    }
}
