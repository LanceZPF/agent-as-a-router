@* Pinned summary for the selected conversation: title row plus one stat strip. Sits above the
   scrollable turn list, so it stays visible while scrolling. *@
<div class="rounded px-3 py-2 shrink-0" style="background:#1e293b;border:1px solid #334155">
    @* Title · fallback badge · session id + time range *@
    <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-semibold text-slate-200 ls-truncate">@Conversation.Title</span>
        @if (Conversation.HasFallbackTurns)
        {
            <span class="shrink-0 rounded px-1.5 py-0.5 text-xs font-semibold ls-tip" tabindex="0" aria-describedby="ls-tooltip"
                  data-tip="One or more turns in this conversation used fallback routing"
                  style="background:#f59e0b22;color:#f59e0b;border:1px solid #f59e0b44">⚠ Fallback</span>
        }
        <span class="ml-auto text-xs font-mono text-slate-500 shrink-0 ls-tip" tabindex="0" aria-describedby="ls-tooltip"
              data-tip="Session ID, followed by the timestamps of the first and last turn">
            <span class="text-sky-400">@Conversation.Id</span> · @Conversation.FirstTimestamp → @Conversation.LastTimestamp
        </span>
    </div>

    @* Aggregate stat strip *@
    <div class="flex flex-wrap items-baseline" style="gap:2px 14px">
        <span class="flex items-baseline gap-1 ls-tip" tabindex="0" aria-describedby="ls-tooltip"
              data-tip="Sum of all LLM API costs for this conversation">
            <span class="ls-stat-label">Total Cost</span>
            <span class="font-mono text-xs" style="color:#10b981">$@Conversation.TotalCost.ToString("F6", CultureInfo.InvariantCulture)</span>
        </span>
        <span class="flex items-baseline gap-1 ls-tip" tabindex="0" aria-describedby="ls-tooltip"
              data-tip="Cumulative prompt + completion tokens sent to the LLM across all turns">
            <span class="ls-stat-label">Total Tokens</span>
            <span class="font-mono text-xs text-slate-200">@((Conversation.TotalPromptTokens + Conversation.TotalCompletionTokens).ToString("N0", CultureInfo.InvariantCulture))</span>
        </span>
        <span class="flex items-baseline gap-1 ls-tip" tabindex="0" aria-describedby="ls-tooltip"
              data-tip="Average cost reduction percentage across all turns in this conversation">
            <span class="ls-stat-label">Avg ROI</span>
            <span class="font-mono text-xs" style="color:@(AvgRoi > 0 ? "#10b981" : "#64748b")">
                @(AvgRoi > 0 ? $"{AvgRoi.ToString("F1", CultureInfo.InvariantCulture)}% ↓" : "—")
            </span>
        </span>
        <span class="flex items-baseline gap-1 ls-tip" tabindex="0" aria-describedby="ls-tooltip"
              data-tip="Number of multi-step agent workflows within this conversation">
            <span class="ls-stat-label">Turns</span>
            <span class="font-mono text-xs text-slate-200">@Conversation.Turns.Count</span>
        </span>
        @if (SparklinePoints.Length > 0)
        {
            <span class="flex items-baseline gap-1 ls-tip" tabindex="0" aria-describedby="ls-tooltip"
                  data-tip="Total tokens per turn across this conversation - watch it climb turn over turn (the hockey stick curve)">
                <span class="ls-stat-label">Trend</span>
                <svg width="@SparklineWidth" height="@SparklineHeight" viewBox="0 0 @SparklineWidth @SparklineHeight" aria-hidden="true">
                    <polyline points="@SparklinePoints" fill="none" stroke="#38bdf8" stroke-width="1.5" />
                </svg>
            </span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Conversation Conversation { get; set; } = null!;

    private decimal AvgRoi => Conversation.Turns.Count == 0 ? 0m : Conversation.Turns.Average(t => t.RoutingRoi);

    private const double SparklineWidth = 48;
    private const double SparklineHeight = 16;

    // Per-turn total-token trend, rendered as a compact inline SVG polyline. The coordinate math
    // lives in AgenticRouter.Gui.Charts (unit-tested there); this just formats the points string.
    private string SparklinePoints
    {
        get
        {
            var turns = Conversation.Turns
                .Select(t => new TurnTokenPoint(t.TurnNumber, t.PromptTokens, t.CompletionTokens))
                .ToList();
            var values = TokenCompoundingSeries.BuildSparkline(turns);
            if (values.Count == 0)
            {
                return string.Empty;
            }

            var points = SparklineLayout.Normalize(values, SparklineWidth, SparklineHeight);
            return string.Join(' ', points.Select(p =>
                $"{p.X.ToString("F1", CultureInfo.InvariantCulture)},{p.Y.ToString("F1", CultureInfo.InvariantCulture)}"));
        }
    }
}
