@* Pinned summary card: aggregate metrics for the selected conversation. Sits above the
   scrollable turn list, so it stays visible while scrolling. *@
<div class="rounded p-3 shrink-0" style="background:#1e293b;border:1px solid #334155">
    @* Title row *@
    <div class="flex items-center gap-2 mb-1">
        <span class="text-xs font-semibold text-slate-200 ls-truncate">@Conversation.Title</span>
        @if (Conversation.HasFallbackTurns)
        {
            <span class="ml-auto shrink-0 rounded px-1.5 py-0.5 text-xs font-semibold"
                  style="background:#f59e0b22;color:#f59e0b;border:1px solid #f59e0b44"
                  title="One or more turns in this conversation used fallback routing">⚠ Fallback used</span>
        }
    </div>

    @* Session id + time range *@
    <div class="flex items-center gap-3 text-xs font-mono text-slate-500 mb-3">
        <span>Session <span class="text-sky-400">@Conversation.Id</span></span>
        <span title="Timestamps of the first and last turn in this conversation">
            @Conversation.FirstTimestamp <span class="text-slate-600">→</span> @Conversation.LastTimestamp
        </span>
    </div>

    @* Aggregate metric tiles *@
    <div class="grid gap-2" style="grid-template-columns:repeat(4,minmax(0,1fr))">
        <div class="ls-tile" title="Sum of all LLM API costs for this conversation">
            <div class="font-mono text-sm" style="color:#10b981">$@Conversation.TotalCost.ToString("F6", CultureInfo.InvariantCulture)</div>
            <div class="ls-tile-label">Total Cost</div>
        </div>
        <div class="ls-tile" title="Cumulative prompt + completion tokens sent to the LLM across all turns">
            <div class="font-mono text-sm text-slate-200">@((Conversation.TotalPromptTokens + Conversation.TotalCompletionTokens).ToString("N0", CultureInfo.InvariantCulture))</div>
            <div class="ls-tile-label">Total Tokens</div>
        </div>
        <div class="ls-tile" title="Average cost reduction percentage across all turns in this conversation">
            <div class="font-mono text-sm" style="color:@(AvgRoi > 0 ? "#10b981" : "#64748b")">
                @(AvgRoi > 0 ? $"{AvgRoi.ToString("F1", CultureInfo.InvariantCulture)}% ↓" : "—")
            </div>
            <div class="ls-tile-label">Avg Routing ROI</div>
        </div>
        <div class="ls-tile" title="Number of multi-step agent workflows within this conversation">
            <div class="font-mono text-sm text-slate-200">@Conversation.Turns.Count</div>
            <div class="ls-tile-label">Turns</div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Conversation Conversation { get; set; } = null!;

    private decimal AvgRoi => Conversation.Turns.Count == 0 ? 0m : Conversation.Turns.Average(t => t.RoutingRoi);
}
