@* Pinned summary card showing aggregate metrics for selected conversation. *@
<div class="rounded p-3 shrink-0 sticky top-0 z-10" style="background:#1e293b;border:1px solid #334155">
    @* Header with Session ID and Warnings *@
    <div class="flex items-baseline justify-between mb-3 gap-2">
        <div class="flex items-baseline gap-2">
            <span class="text-xs text-slate-400">Session:</span>
            <span class="font-mono text-xs text-sky-400">@Conversation.Id</span>
        </div>
        @if (Conversation.HasFallbackTurns)
        {
            <span class="shrink-0 rounded px-1.5 py-0.5 text-xs font-semibold"
                  style="background:#f59e0b22;color:#f59e0b;border:1px solid #f59e0b44">⚠️ Fallback Used</span>
        }
    </div>

    <div class="text-xs text-slate-500 mb-3">
        📅 @Conversation.FirstTimestamp → @Conversation.LastTimestamp
    </div>

    @* Metrics Grid *@
    <div class="grid grid-cols-4 gap-2 text-xs">
        @* Total Cost *@
        <div class="rounded p-2.5 text-center" style="background:#0f172a">
            <div class="font-mono text-sm text-slate-200">$@Money6(Conversation.TotalCost)</div>
            <div class="text-slate-500 mt-0.5 cursor-help" title="Sum of all LLM API costs for this conversation">
                💰 Total Cost
            </div>
        </div>

        @* Total Tokens *@
        <div class="rounded p-2.5 text-center" style="background:#0f172a">
            <div class="font-mono text-sm text-slate-200">@TokenCount(Conversation.TotalPromptTokens + Conversation.TotalCompletionTokens)</div>
            <div class="text-slate-500 mt-0.5 cursor-help" title="Cumulative prompt + completion tokens sent to LLM across all turns">
                📊 Total Tokens
            </div>
        </div>

        @* Avg Routing ROI *@
        <div class="rounded p-2.5 text-center" style="background:#0f172a">
            <div class="font-mono text-sm" style="color:#10b981">@AvgRoi.ToString("F1")% ↓</div>
            <div class="text-slate-500 mt-0.5 cursor-help" title="Average cost reduction percentage across all turns in this conversation">
                🎯 Avg ROI
            </div>
        </div>

        @* Turn Count *@
        <div class="rounded p-2.5 text-center" style="background:#0f172a">
            <div class="font-mono text-sm text-slate-200">@Conversation.Turns.Count</div>
            <div class="text-slate-500 mt-0.5 cursor-help" title="Number of multi-step agent workflows within this conversation">
                🔄 Turns
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Conversation Conversation { get; set; } = null!;

    private decimal AvgRoi => Conversation.Turns.Count > 0
        ? Conversation.Turns.Average(t => t.RoutingRoi)
        : 0m;

    private static string Money6(decimal value) => value.ToString("F6", System.Globalization.CultureInfo.InvariantCulture);

    private static string TokenCount(int tokens)
    {
        if (tokens >= 1_000_000)
            return $"{tokens / 1_000_000.0:F1}M";
        if (tokens >= 1_000)
            return $"{tokens / 1_000.0:F1}K";
        return tokens.ToString();
    }
}
