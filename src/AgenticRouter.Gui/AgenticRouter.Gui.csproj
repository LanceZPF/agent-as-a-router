<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Windows-only .NET MAUI Blazor Hybrid app: a BlazorWebView hosts the Razor dashboard, and the
         window lives in the system tray (see Platforms/Windows/TrayWindowManager.cs). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>AgenticRouter.Gui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <ApplicationTitle>AgenticRouter</ApplicationTitle>
    <ApplicationId>com.agenticrouter.gui</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!-- Unpackaged (no MSIX) so `dotnet run` / F5 work without package registration or signing. -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#0f172a" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.80" />
    <!-- Charts: Blazor wrapper for ApexCharts.js. The MAUI flavor registers the chart service via
         AddApexChartsMaui() and bundles its JS as static web assets, so it works offline in the
         BlazorWebView. -->
    <PackageReference Include="Blazor-ApexCharts-MAUI" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Plain net10.0 library: chart data-transformation logic, kept out of this Windows-only
         project so it's unit-testable on any platform. See AgenticRouter.Gui.Charts.Tests. -->
    <ProjectReference Include="..\AgenticRouter.Gui.Charts\AgenticRouter.Gui.Charts.csproj" />
  </ItemGroup>

</Project>
