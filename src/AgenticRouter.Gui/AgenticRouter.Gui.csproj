<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe hides the console window; the app only shows a tray icon and, on demand, the dashboard. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- NotifyIcon (system tray icon + context menu) comes from Windows Forms. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- dashboard/ is a separate npm-managed subproject (source only - node_modules, .tsx, etc.); it is
         built by `npm run build` into wwwroot/ (see dashboard/vite.config.ts) and must not be globbed
         into this project's own item list. -->
    <Compile Remove="dashboard\**" />
    <None Remove="dashboard\**" />
    <Content Remove="dashboard\**" />

    <Compile Remove="wwwroot\**" />
    <None Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

</Project>
