{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Routing": {
    "DefaultModel": "kimi-k2.5",
    "MaxCandidates": 8,
    "MaxNeighborCount": 10,
    "EnableExploration": true,
    "ExplorationRate": 0.05,
    "PolicyName": "hierarchical"
  },
  "ModelRouting": {
    "Providers": {
      "openai": {
        "BaseUrl": "https://api.openai.com",
        "ApiKeyEnvVar": "OPENAI_API_KEY",
        "AuthHeaderName": "Authorization",
        "AuthHeaderScheme": "Bearer"
      },
      "anthropic": {
        "BaseUrl": "https://api.anthropic.com",
        "ApiKeyEnvVar": "ANTHROPIC_API_KEY",
        "AuthHeaderName": "x-api-key",
        "AuthHeaderScheme": ""
      },
      "alibaba": {
        "BaseUrl": "https://dashscope.aliyuncs.com",
        "ApiKeyEnvVar": "QWEN_API_KEY",
        "AuthHeaderName": "Authorization",
        "AuthHeaderScheme": "Bearer"
      },
      "zhipu": {
        "BaseUrl": "https://open.bigmodel.cn",
        "ApiKeyEnvVar": "GLM_API_KEY",
        "AuthHeaderName": "Authorization",
        "AuthHeaderScheme": "Bearer"
      },
      "moonshot": {
        "BaseUrl": "https://api.moonshot.cn",
        "ApiKeyEnvVar": "KIMI_API_KEY",
        "AuthHeaderName": "Authorization",
        "AuthHeaderScheme": "Bearer"
      },
      "minimax": {
        "BaseUrl": "https://api.minimax.chat",
        "ApiKeyEnvVar": "MINIMAX_API_KEY",
        "AuthHeaderName": "Authorization",
        "AuthHeaderScheme": "Bearer"
      }
    },
    "ModelList": [
      { "ModelName": "gpt-5.4", "Provider": "openai", "ProviderModelId": "gpt-5.4" },
      { "ModelName": "qwen3-max", "Provider": "alibaba", "ProviderModelId": "qwen3-max" },
      { "ModelName": "qwen3.5-plus", "Provider": "alibaba", "ProviderModelId": "qwen3.5-plus" },
      { "ModelName": "glm-5", "Provider": "zhipu", "ProviderModelId": "glm-5" },
      { "ModelName": "kimi-k2.5", "Provider": "moonshot", "ProviderModelId": "kimi-k2.5" },
      { "ModelName": "minimax-m2.7", "Provider": "minimax", "ProviderModelId": "minimax-m2.7" },
      { "ModelName": "claude-opus-4.6", "Provider": "anthropic", "ProviderModelId": "claude-opus-4-6" },
      { "ModelName": "claude-sonnet-4.6", "Provider": "anthropic", "ProviderModelId": "claude-sonnet-4-6" },
      { "ModelName": "claude-fable-5", "Provider": "anthropic", "ProviderModelId": "claude-fable-5" },
      { "ModelName": "claude-opus-4-8", "Provider": "anthropic", "ProviderModelId": "claude-opus-4-8" },
      { "ModelName": "claude-sonnet-5", "Provider": "anthropic", "ProviderModelId": "claude-sonnet-5" },
      { "ModelName": "claude-haiku-4-5-20251001", "Provider": "anthropic", "ProviderModelId": "claude-haiku-4-5-20251001" }
    ]
  },
  "Pricing": {
    "_comment": "USD per 1,000,000 tokens, keyed by ModelRouting:ModelList[].ModelName. Illustrative placeholder values, not verified against current provider price sheets - confirm before relying on these for real cost estimates. A model missing here simply has no estimated cost (Telemetry.PricingOptions.Models is a plain lookup, not a required allowlist).",
    "Models": {
      "gpt-5.4": { "InputPerMillionTokens": 3.00, "OutputPerMillionTokens": 12.00 },
      "qwen3-max": { "InputPerMillionTokens": 1.20, "OutputPerMillionTokens": 4.80 },
      "qwen3.5-plus": { "InputPerMillionTokens": 0.60, "OutputPerMillionTokens": 2.40 },
      "glm-5": { "InputPerMillionTokens": 1.00, "OutputPerMillionTokens": 4.00 },
      "kimi-k2.5": { "InputPerMillionTokens": 0.60, "OutputPerMillionTokens": 2.50 },
      "minimax-m2.7": { "InputPerMillionTokens": 0.80, "OutputPerMillionTokens": 3.20 },
      "claude-opus-4.6": { "InputPerMillionTokens": 15.00, "OutputPerMillionTokens": 75.00 },
      "claude-sonnet-4.6": { "InputPerMillionTokens": 3.00, "OutputPerMillionTokens": 15.00 },
      "claude-fable-5": { "InputPerMillionTokens": 3.00, "OutputPerMillionTokens": 15.00 },
      "claude-opus-4-8": { "InputPerMillionTokens": 15.00, "OutputPerMillionTokens": 75.00 },
      "claude-sonnet-5": { "InputPerMillionTokens": 3.00, "OutputPerMillionTokens": 15.00 },
      "claude-haiku-4-5-20251001": { "InputPerMillionTokens": 0.80, "OutputPerMillionTokens": 4.00 }
    }
  },
  "AllowedHosts": "*"
}
